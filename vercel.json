{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/media-diagnostic",
      "destination": "/luxury-lens",
      "permanent": true
    },
    {
      "source": "/la-rosa",
      "destination": "/lechelon",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
